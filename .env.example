# Python 3.11+; the Windows scripts use the repository-local .venv.
# Listen on the LAN so a phone on the same private network can connect.
POCKET_ENTERTAINMENT_CATALOG_HOST=0.0.0.0
POCKET_ENTERTAINMENT_CATALOG_PORT=8766

# Optional address printed at startup; normally discovered automatically.
POCKET_ENTERTAINMENT_CATALOG_PUBLIC_HOST=

# Relative paths are resolved from the repository root. Keep these on local disk.
POCKET_ENTERTAINMENT_CATALOG_DATA=data/catalog.jsonl
POCKET_ENTERTAINMENT_CATALOG_WORK_DATA=data/editing.sqlite3
