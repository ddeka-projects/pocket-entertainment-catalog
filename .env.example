# Listen on every local interface so trusted devices on the same LAN can connect.
POCKET_CATALOG_HOST=0.0.0.0
POCKET_CATALOG_PORT=8766

# Usually leave blank; the server discovers the LAN address shown at startup.
POCKET_CATALOG_PUBLIC_HOST=

# Relative paths are resolved from the project folder.
POCKET_CATALOG_DATA=data/catalog.jsonl

# Local Work profile database (excluded from Git).
POCKET_CATALOG_WORK_DATA=data/editing.sqlite3

# Windows only: normally auto-detected. Set an explicit executable if the
# scheduled task cannot find Python, for example C:\Python313\python.exe.
POCKET_CATALOG_PYTHON=
